---
import SiteLayout from '../layouts/site-layout.astro';
import factorial from '../assets/factorial.bd?raw';
import { highlightBirdie } from '../lib/birdie-editor';

const examples = [
  {
    id: 'addition',
    label: 'Add two numbers',
    source: 'fn add(a: int, b: int) int:\n    return a + b\n\nadd(20, 22)',
  },
  {
    id: 'larger',
    label: 'Larger of two numbers',
    source: `fn larger(a: int, b: int) int:
    if a > b:
        return a
    else:
        return b

larger(7, 12)`,
  },
  {
    id: 'factorial',
    label: 'Recursive factorial',
    source: `${factorial.trimEnd()}\n\nfactorial(5)`,
  },
  {
    id: 'diagnostic',
    label: 'Unknown variable',
    source: 'fn answer() int:\n    return missing\n\nanswer()',
  },
] as const;

const starter = examples[0].source;
const previewTokens = highlightBirdie(starter);
---

<SiteLayout title="Birdie Playground | Run Birdie Online" description="Write and run Birdie code in your browser.">
  <birdie-playground class="playground wrap">
    <header class="intro">
      <h1>Playground<span class="red-period">.</span></h1>
    </header>

    <div class="code-sheet">
      <div class="toolbar">
        <select name="example" aria-label="Examples" disabled>
          <option value="" disabled selected>Choose example</option>
          {examples.map(({ id, label, source }) => <option value={id} data-source={source}>{label}</option>)}
        </select>
        <button class="button button-primary" type="button" data-run disabled aria-keyshortcuts="Control+Enter Meta+Enter">
          Run <kbd aria-hidden="true" class="shortcut-meta">⌘ ↵</kbd><kbd aria-hidden="true" class="shortcut-control">Ctrl ↵</kbd>
        </button>
      </div>

      <div class="panes">
        <div class="editor-pane">
          <h2 class="pane-heading filename" id="editor-title">main.bd</h2>
          <div data-editor data-source={starter}>
            <div class="editor-preview" data-editor-preview>
              <div class="preview-gutter" aria-hidden="true">
                {starter.split('\n').map((_, index) => <div>{index + 1}</div>)}
              </div>
              <pre><code>{previewTokens.map(({ text, className }) => className ? <span class={className}>{text}</span> : text)}</code></pre>
            </div>
          </div>
        </div>
        <section class="output-pane" aria-labelledby="output-title">
          <h2 class="pane-heading" id="output-title">Result</h2>
          <div class="result" aria-live="polite">
            <p data-status>Run your code to see the result.</p>
            <pre data-value hidden></pre>
            <div class="diagnostics" data-diagnostics></div>
          </div>
          <noscript><p class="no-script">Enable JavaScript to use the playground controls.</p></noscript>
        </section>
      </div>

      <div class="code-sheet-footer">
        <span>Runs in your browser</span>
        <span id="editor-help">Press <kbd>Esc</kbd> then <kbd>Tab</kbd> to leave the editor</span>
      </div>
    </div>
  </birdie-playground>
</SiteLayout>

<script>
  import { defaultKeymap, history, historyKeymap, indentWithTab, isolateHistory } from '@codemirror/commands';
  import { diagnosticCount, setDiagnostics, setDiagnosticsEffect } from '@codemirror/lint';
  import { EditorState } from '@codemirror/state';
  import { drawSelection, EditorView, keymap, lineNumbers } from '@codemirror/view';
  import { birdieEditorLanguage } from '../lib/birdie-editor';
  import { BirdieRuntime, editorDiagnostics } from '../lib/birdie-runtime';

  const idleMessage = 'Run your code to see the result.';
  const feedbackDelay = 250;

  class BirdiePlayground extends HTMLElement {
    #editor?: EditorView;
    #runtime = new BirdieRuntime();

    initialize() {
      if (this.#editor) return;
      const editorHost = this.querySelector<HTMLElement>('[data-editor]');
      const preview = this.querySelector<HTMLElement>('[data-editor-preview]');
      const starter = editorHost?.dataset.source;
      const examples = this.querySelector('select');
      const runButton = this.querySelector<HTMLButtonElement>('[data-run]');
      const status = this.querySelector('[data-status]');
      const value = this.querySelector<HTMLPreElement>('[data-value]');
      const diagnosticList = this.querySelector('[data-diagnostics]');
      if (!editorHost || !preview || starter === undefined || !examples || !runButton || !status || !value || !diagnosticList) return;

      const exampleId = new URLSearchParams(window.location.search).get('example');
      const initialExample = Array.from(examples.options).find((option) => option.value === exampleId);

      this.#runtime.warmUp();
      let running = false;

      const showStatus = (message: string) => {
        if (status.textContent !== message) status.textContent = message;
        value.hidden = true;
        diagnosticList.replaceChildren();
      };

      const run = async (editor: EditorView) => {
        if (running) return;
        const { doc } = editor.state;
        const source = doc.toString();
        if (!source.trim()) {
          showStatus('Enter Birdie code or pick an example.');
          return;
        }

        running = true;
        runButton.setAttribute('aria-disabled', 'true');
        const isCurrent = () => this.#editor === editor && editor.state.doc === doc;
        const showFeedback = (message: string) => {
          if (!isCurrent()) return;
          showStatus(message);
          if (diagnosticCount(editor.state)) editor.dispatch(setDiagnostics(editor.state, []));
        };
        let feedback = setTimeout(() => showFeedback('Starting Birdie…'), feedbackDelay);

        try {
          const result = await this.#runtime.run(source, () => {
            clearTimeout(feedback);
            feedback = setTimeout(() => showFeedback('Running…'), feedbackDelay);
          });
          if (!isCurrent()) return;

          const diagnostics = editorDiagnostics(source, result.diagnostics);
          if (diagnostics.length || diagnosticCount(editor.state)) {
            editor.dispatch(setDiagnostics(editor.state, diagnostics));
          }
          if (diagnostics.length) {
            showStatus(diagnostics.length === 1 ? '1 error' : `${diagnostics.length} errors`);
            for (const { from, to, message } of diagnostics) {
              const line = doc.lineAt(from);
              const column = Array.from(line.text.slice(0, from - line.from)).length + 1;
              const button = document.createElement('button');
              button.type = 'button';
              button.className = 'diagnostic';
              const location = document.createElement('span');
              location.className = 'filename';
              location.textContent = `${line.number}:${column}`;
              const description = document.createElement('span');
              description.className = 'diagnostic-message';
              description.textContent = message;
              const jump = document.createElement('span');
              jump.setAttribute('aria-hidden', 'true');
              jump.textContent = '↖';
              button.append(location, description, jump);
              button.onclick = () => {
                editor.dispatch({ selection: { anchor: from, head: to }, scrollIntoView: true });
                editor.focus();
              };
              diagnosticList.append(button);
            }
          } else if (result.value === null) {
            showStatus('Finished with no value.');
          } else {
            showStatus('Output');
            value.textContent = result.value;
            value.hidden = false;
          }
        } catch (error) {
          showFeedback(error instanceof Error ? error.message : 'Could not run Birdie.');
        } finally {
          clearTimeout(feedback);
          running = false;
          if (this.#editor === editor) runButton.removeAttribute('aria-disabled');
        }
      };

      const runShortcut = (editor: EditorView) => {
        void run(editor);
        return true;
      };

      const editor = new EditorView({
        parent: editorHost,
        doc: initialExample?.dataset.source ?? starter,
        extensions: [
          birdieEditorLanguage,
          lineNumbers(),
          drawSelection(),
          history(),
          EditorState.tabSize.of(4),
          EditorView.contentAttributes.of({
            'aria-labelledby': 'editor-title',
            'aria-describedby': 'editor-help',
            autocapitalize: 'off',
          }),
          keymap.of([
            { key: 'Ctrl-Enter', run: runShortcut },
            { key: 'Meta-Enter', run: runShortcut },
            indentWithTab,
            ...defaultKeymap,
            ...historyKeymap,
          ]),
          EditorState.transactionExtender.of((transaction) =>
            transaction.docChanged && diagnosticCount(transaction.startState)
              ? { effects: setDiagnosticsEffect.of([]) }
              : null),
          EditorView.updateListener.of((update) => {
            if (update.docChanged) showStatus(idleMessage);
          }),
        ],
      });
      this.#editor = editor;
      preview.hidden = true;
      showStatus(idleMessage);
      examples.disabled = false;
      runButton.disabled = false;
      runButton.removeAttribute('aria-disabled');

      runButton.onclick = () => run(editor);
      examples.onchange = () => {
        const source = examples.selectedOptions[0]?.dataset.source;
        if (source !== undefined && source !== editor.state.doc.toString()) {
          editor.dispatch({
            changes: { from: 0, to: editor.state.doc.length, insert: source },
            selection: { anchor: 0 },
            annotations: isolateHistory.of('full'),
            scrollIntoView: true,
          });
        }
        examples.value = '';
      };
    }

    disconnectedCallback() {
      this.#editor?.destroy();
      this.#editor = undefined;
      const preview = this.querySelector<HTMLElement>('[data-editor-preview]');
      if (preview) preview.hidden = false;
      this.#runtime.dispose();
    }
  }

  customElements.define('birdie-playground', BirdiePlayground);

  const initializePlayground = () => {
    document.querySelector<BirdiePlayground>('birdie-playground')?.initialize();
  };

  // ClientRouter swaps the document before updating window.location.
  document.addEventListener('astro:page-load', initializePlayground);
  initializePlayground();
</script>

<style>
  .playground {
    --syntax-literal: #0550ae;
    --syntax-string: #0a3069;
    --syntax-function: #6639ba;
    --editor-height: clamp(21rem, 48vh, 32rem);
    display: block;
    padding-block: 56px 80px;
  }
  :global([data-theme='dark']) .playground {
    --syntax-literal: #79c0ff;
    --syntax-string: #a5d6ff;
    --syntax-function: #d2a8ff;
  }
  .intro { margin-bottom: 28px; }
  h1 { margin-bottom: 0; font-size: clamp(2.75rem, 6vw, 4.5rem); font-weight: 660; line-height: 1.04; letter-spacing: -0.065em; }
  .toolbar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--line); }
  select { min-width: 0; max-width: 100%; min-height: 40px; padding-inline: 10px; border: 1px solid var(--line); border-radius: 4px; color: var(--ink); background: var(--paper); font-size: 0.8125rem; cursor: pointer; }
  .toolbar .button { min-height: 40px; padding: 8px 14px; gap: 14px; }
  .toolbar :disabled { cursor: not-allowed; }
  .toolbar .button:disabled:hover { background: var(--ink); }
  kbd { font-size: 0.6875rem; }
  .toolbar kbd { display: none; }
  @media (pointer: fine) {
    :global([data-shortcut-modifier='meta']) .toolbar .shortcut-meta,
    :global([data-shortcut-modifier='control']) .toolbar .shortcut-control { display: inline; }
  }
  .panes { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
  .output-pane { border-inline-start: 1px solid var(--line); background: var(--soft); }
  .pane-heading { margin: 0; padding: 12px 18px; border-bottom: 1px solid var(--line); font-size: 0.75rem; font-weight: 550; line-height: 1.5; }
  [data-editor] { font: 0.9375rem/1.8 var(--font-mono); }
  [data-editor] :global(.birdie-keyword) { color: var(--accent); }
  [data-editor] :global(.birdie-literal) { color: var(--syntax-literal); }
  [data-editor] :global(.birdie-string) { color: var(--syntax-string); }
  [data-editor] :global(.birdie-function) { color: var(--syntax-function); }
  [data-editor] :global(.birdie-comment) { color: var(--muted); }

  .editor-preview { display: flex; height: var(--editor-height); overflow: auto; }
  .preview-gutter { position: sticky; inset-inline-start: 0; flex: none; padding-block: 14px; text-align: end; }
  .editor-preview pre { margin: 0; padding: 14px 18px 14px 12px; font: inherit; white-space: pre; }
  .editor-preview code { font: inherit; }

  .editor-pane :global(.cm-editor) { height: var(--editor-height); }
  .editor-pane :global(.cm-editor.cm-focused) { outline: none; }
  .editor-pane:focus-within .pane-heading { border-bottom-color: var(--accent); }
  .editor-pane :global(.cm-scroller) { font: inherit; }
  .editor-pane :global(.cm-content) { padding-block: 14px; }
  .editor-pane :global(.cm-line) { padding-inline: 12px 18px; }
  .preview-gutter, .editor-pane :global(.cm-gutters) { background: var(--paper); border-right: 1px solid var(--line); color: var(--muted); }
  .preview-gutter > div, .editor-pane :global(.cm-lineNumbers .cm-gutterElement) { min-width: 3ch; padding-inline: 8px; }
  .editor-pane :global(.cm-cursor) { border-left-color: var(--ink); }
  .editor-pane :global(.cm-editor .cm-selectionBackground),
  .editor-pane :global(.cm-editor.cm-focused > .cm-scroller > .cm-selectionLayer .cm-selectionBackground) {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
  }
  .editor-pane :global(.cm-lintRange-error) {
    background-image: none;
    text-decoration: underline wavy var(--accent);
    text-underline-offset: 0.25em;
  }
  .editor-pane :global(.cm-tooltip) { border-color: var(--line); background: var(--paper); color: var(--ink); }
  .editor-pane :global(.cm-diagnostic-error) { border-inline-start-color: var(--accent); }

  .result { padding: 16px 18px 24px; overflow-wrap: anywhere; }
  .result p, .no-script { margin: 0; color: var(--muted); font-size: 0.8125rem; line-height: 1.6; }
  .no-script { margin: 0 18px 16px; }
  .result pre { margin: 8px 0 0; padding: 0; font-size: 1.25rem; white-space: pre-wrap; }
  .diagnostics:not(:empty) { display: grid; gap: 8px; margin-top: 12px; }
  .diagnostics :global(.diagnostic) {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr) max-content;
    align-items: baseline;
    gap: 6px;
    width: 100%;
    padding: 10px;
    border-inline-start: 2px solid var(--accent);
    border-radius: 0 4px 4px 0;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.8125rem;
    line-height: 1.6;
    text-align: left;
  }
  .diagnostics :global(.diagnostic:hover .diagnostic-message) { text-decoration: underline; text-underline-offset: 3px; }
  .code-sheet-footer { padding-inline: 18px; }
  @media (max-width: 680px) {
    .playground { --editor-height: clamp(15rem, 38vh, 21rem); padding-block: 38px 56px; }
    .panes { grid-template-columns: minmax(0, 1fr); }
    [data-editor] { font-size: 1rem; }
    .output-pane { border-inline-start: 0; border-top: 1px solid var(--line); min-height: 130px; }
  }
  @media (max-width: 520px) {
    select { flex: 1 1 0; max-width: 12rem; }
    select, .toolbar .button { min-height: 44px; }
  }
  @media (pointer: coarse) {
    #editor-help { display: none; }
  }
</style>
