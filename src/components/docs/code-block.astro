---
import { Code } from 'astro:components';
import { birdieGrammar } from '../../lib/birdie-grammar';

interface Props {
  code: string;
  lang: 'birdie' | 'python';
  filename: string;
  status?: string;
}

const { code, lang, filename, status } = Astro.props;
---

<div class="docs-code">
  <div class="docs-code-toolbar">
    <span class="docs-code-filename" title={filename}>{filename}</span>
    {status && <span class="proposed-label">{status}</span>}
  </div>
  <Code
    code={code.trimEnd()}
    lang={lang === 'birdie' ? birdieGrammar : 'python'}
    themes={{ light: 'github-light', dark: 'github-dark' }}
    defaultColor={false}
    tabindex="0"
    aria-label={filename}
  />
</div>
